# Copy to .env and adjust. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL (docker compose defaults)
DATABASE_URL=postgresql://manuver:manuver_dev_password@localhost:5432/manuver?schema=public
TEST_DATABASE_URL=postgresql://manuver:manuver_dev_password@localhost:5432/manuver_test?schema=public

# JWT — use long random strings (at least 32 characters). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Google Sign-In: OAuth client IDs whose ID tokens are accepted (comma separated:
# iOS, Android, web). Leave empty to disable Google login.
GOOGLE_CLIENT_IDS=

# Comma-separated origins allowed by CORS (the Expo web dev server, etc.). Native apps send no Origin.
CORS_ORIGINS=http://localhost:8081,http://localhost:8082

# Uploaded photos are stored here (relative to the server folder) and served at /uploads.
UPLOAD_DIR=uploads
# Public base URL used to build photo links. Set to the tunnel/deploy URL when testing on a phone.
PUBLIC_BASE_URL=http://localhost:4000

# Google sign-in (OAuth 2.0 web client, used by the server). Leave empty to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Origins the app reaches the API through; register <origin>/v1/auth/google/callback for each in Google Cloud.
OAUTH_ORIGINS=http://localhost:8082


# Email via Resend. Empty key = emails go to the log in development.
RESEND_API_KEY=
EMAIL_FROM=Manuver <onboarding@resend.dev>

# Photo storage. "local" = this server's disk (development). Production: "s3" with any S3-compatible
# bucket (hosting disks are wiped on every deploy). Free option: Supabase Storage. Steps for Supabase,
# Backblaze B2 and Cloudflare R2 are in docs/DEPLOY.md.
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public address of the bucket, without a trailing slash.
S3_PUBLIC_URL=
# true for Supabase Storage; false for B2 and R2.
S3_FORCE_PATH_STYLE=false
